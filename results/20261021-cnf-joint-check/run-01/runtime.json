              "image": "docker.io/envoyproxy/envoy@sha256:63dd445d23d7d419d1bba8b2b9b1b8fdb80f38ae1516fb5d2dcd8856713b7eac",
              "imagePullPolicy": "IfNotPresent",
              "name": "envoy",
              "ports": [
