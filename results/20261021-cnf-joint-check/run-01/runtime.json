{
  "deployments": {
    "cnf-m1-backend": {
      "progressDeadlineSeconds": 600,
      "replicas": 1,
      "revisionHistoryLimit": 10,
      "selector": {
        "matchLabels": {
          "app": "cnf-m1-backend"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
        "metadata": {
          "annotations": {
            "cnf.lab/joint-version": "cnf-joint-check-v1"
          },
          "creationTimestamp": null,
          "labels": {
            "app": "cnf-m1-backend",
            "app.kubernetes.io/part-of": "cnf-m1"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "args": [
                "-s",
                "-p",
                "5201",
                "--forceflush",
                "-V"
              ],
              "command": [
                "iperf3"
              ],
              "image": "docker.io/local/ueransim-iperf3@sha256:2c464fbf9eccafe187e2a2565e6ee3cdb4c3e256f76d223bf520103dc30e803b",
              "imagePullPolicy": "Never",
              "name": "iperf3",
              "ports": [
                {
                  "containerPort": 5201,
                  "name": "iperf",
                  "protocol": "TCP"
                }
              ],
              "readinessProbe": {
                "exec": {
                  "command": [
                    "sh",
                    "-ec",
                    "kill -0 1"
                  ]
                },
                "failureThreshold": 3,
                "initialDelaySeconds": 2,
                "periodSeconds": 5,
                "successThreshold": 1,
                "timeoutSeconds": 1
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "64Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              },
              "terminationMessagePath": "/dev/termination-log",
              "terminationMessagePolicy": "File",
              "volumeMounts": [
                {
                  "mountPath": "/tmp",
                  "name": "scratch"
                }
              ]
            },
            {
              "command": [
                "sleep",
                "infinity"
              ],
              "image": "docker.io/local/ueransim-iperf3@sha256:2c464fbf9eccafe187e2a2565e6ee3cdb4c3e256f76d223bf520103dc30e803b",
              "imagePullPolicy": "Never",
              "name": "tc",
              "readinessProbe": {
                "exec": {
                  "command": [
                    "sh",
                    "-ec",
                    "kill -0 1"
                  ]
                },
                "failureThreshold": 3,
                "periodSeconds": 5,
                "successThreshold": 1,
                "timeoutSeconds": 1
              },
              "resources": {
                "limits": {
                  "cpu": "100m",
                  "memory": "64Mi"
                },
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "add": [
                    "NET_ADMIN"
                  ],
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsGroup": 0,
                "runAsNonRoot": false,
                "runAsUser": 0
              },
              "terminationMessagePath": "/dev/termination-log",
              "terminationMessagePolicy": "File"
            }
          ],
          "dnsPolicy": "ClusterFirst",
          "nodeSelector": {
            "5gc.free5gc.org/plane": "control"
          },
          "restartPolicy": "Always",
          "schedulerName": "default-scheduler",
          "securityContext": {
            "fsGroup": 65532,
            "runAsGroup": 65532,
            "runAsNonRoot": true,
            "runAsUser": 65532,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "terminationGracePeriodSeconds": 30,
          "volumes": [
            {
              "emptyDir": {
                "medium": "Memory",
                "sizeLimit": "16Mi"
              },
              "name": "scratch"
            }
          ]
        }
      }
    },
