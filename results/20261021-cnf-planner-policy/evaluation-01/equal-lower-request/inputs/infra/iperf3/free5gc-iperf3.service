[Unit]
Description=free5GC lab iperf3 data-network endpoint
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/iperf3 --server --bind 192.168.244.128 --port 5201
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
