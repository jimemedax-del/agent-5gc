                  "containerPort": 15201,
                  "name": "core",
                  "protocol": "TCP"
                },
                {
                  "containerPort": 15202,
                  "name": "edge",
                  "protocol": "TCP"
                }
              ],
              "readinessProbe": {
                "exec": {
                  "command": [
                    "sh",
                    "-ec",
                    "kill -0 1"
                  ]
                },
                "failureThreshold": 3,
                "initialDelaySeconds": 2,
                "periodSeconds": 5,
                "successThreshold": 1,
                "timeoutSeconds": 1
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "64Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              },
              "terminationMessagePath": "/dev/termination-log",
              "terminationMessagePolicy": "File",
              "volumeMounts": [
                {
                  "mountPath": "/etc/envoy",
                  "name": "config",
                  "readOnly": true
                }
              ]
            }
          ],
          "dnsPolicy": "ClusterFirst",
          "nodeSelector": {
            "5gc.free5gc.org/plane": "control"
          },
          "restartPolicy": "Always",
          "schedulerName": "default-scheduler",
          "securityContext": {
            "runAsGroup": 65532,
            "runAsNonRoot": true,
            "runAsUser": 65532,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "terminationGracePeriodSeconds": 30,
          "volumes": [
            {
              "configMap": {
                "defaultMode": 420,
                "name": "cnf-m2-envoy"
              },
              "name": "config"
            }
          ]
        }
      }
    },
